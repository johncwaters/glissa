node_modules
.env
*.log
.omc/
.DS_Store
coverage/
dist/
.vscode/
.claude/*
!.claude/omc.jsonc
!.claude/release-profile.yml
config.json
# Remote-mode device pairings (hashes only, but machine-local state). Sits next to config.json, so a
# dev run with the in-repo config.json lands them here.
pairings.json
pairings-seen.json
# Images uploaded from the phone (POST /upload/:sessionId). Same story: a dev run resolves the in-repo
# config.json, so they land beside it and must never be swept into a commit by a `git add -A`.
uploads/
# Long-term memory signing key and projection. Same story again: a dev run resolves the in-repo
# config.json, and durable remembered content must never become git-visible.
/memory/
# The machine-wide sqlite database (the memory canon lives in it). Same reason, same place.
/glissa.db
/glissa.db-wal
/glissa.db-shm
.pty-capture/
# Runtime output (team runs, post-turn checker telemetry, etc). Not a deliverable.
# Excludes the project pack (.glissa/pack/, .glissa/teams/*/pack/), which AGENTS.md documents as committed.
.glissa/post-turn/
.glissa/teams/*/runs/
.glissa/teams/*/log.md
# Leftovers from a retired team id; the live teams are listed in teams/.
.glissa/teams/release-notes/
# Local scratch repo used for integration testing; not part of the package.
ita-test/

# compiled-commit runner scratch
.compiled-commit-tmp/

# Packaged VS Code extension artifact (tools/vscode-navigator); rebuilt by vsce, never committed
*.vsix
