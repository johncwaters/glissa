{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "session/**/*.ts",
    "detection/**/*.ts",
    "notifications/**/*.ts",
    "shared/**/*.ts",
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "test/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    ".claude/**",
    "dist/**",
    "node_modules/**",
    "public/**"
  ]
}
