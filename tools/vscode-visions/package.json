{
  "name": "glissa-visions",
  "displayName": "Glissa Visions",
  "publisher": "johnwaters",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "configuration": {
      "title": "Glissa Visions",
      "properties": {
        "glissaVisions.relayPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to session/visions-relay.js."
        },
        "glissaVisions.port": {
          "type": "number",
          "default": 0,
          "description": "Relay port. Use 0 to let the relay choose its fallback."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
