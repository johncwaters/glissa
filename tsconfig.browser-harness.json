{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ]
  },
  "include": [
    "test/browser/**/*.ts",
    "server/ws-module.d.ts"
  ],
  "exclude": [
    "node_modules/**",
    "dist/**"
  ]
}
