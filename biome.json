{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!**/*.esm.js",
      "!vite.config.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noRedundantUseStrict": "off",
        "noControlCharactersInRegex": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
