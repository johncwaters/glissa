{
  "name": "glissa",
  "version": "0.23.1",
  "private": true,
  "description": "Spawn and manage Claude Code sessions on Windows and Linux with a browser dashboard and real-time xterm.js streaming",
  "type": "commonjs",
  "main": "server.js",
  "bin": {
    "glissa": "bin/glissa.js"
  },
  "files": [
    "bin/glissa.js",
    "bin/path-doctor.js",
    "scripts/prepare-build.js",
    "scripts/postinstall-path-check.js",
    "dist/",
    "!dist/AGENTS.md",
    "!dist/pictures/",
    "server.js",
    "server/",
    "packs/",
    "!packs/AGENTS.md",
    "session/",
    "tools/vscode-visions/",
    "notifications/",
    "detection/",
    "shared/states.js",
    "shared/client-trust.js",
    "shared/client-trust.esm.js",
    "shared/notification-states.js",
    "shared/settings-ranges.js",
    "shared/contracts/",
    "shared/paths.js",
    "shared/usage-config.js"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "author": "John C. Waters <john@johncwaters.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncwaters/glissa.git"
  },
  "homepage": "https://github.com/johncwaters/glissa#readme",
  "bugs": {
    "url": "https://github.com/johncwaters/glissa/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "dashboard",
    "session-manager",
    "xterm",
    "windows",
    "linux"
  ],
  "scripts": {
    "start": "node server.js",
    "lint": "biome check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:all": "tsc --project tsconfig.all.json",
    "test:container": "docker build -f test/container/Dockerfile -t glissa-remote-test . && docker run --rm glissa-remote-test",
    "dev": "vite",
    "dev:server-only": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall-path-check.js",
    "prepare": "node scripts/prepare-build.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.2"
  }
}
