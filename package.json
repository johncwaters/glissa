{
  "name": "glissa",
  "version": "0.24.2",
  "private": true,
  "description": "Spawn and manage Claude Code sessions on Windows and Linux with a browser dashboard and real-time xterm.js streaming",
  "main": "dist/server/index.js",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "bin": {
    "glissa": "dist/bin/glissa.js"
  },
  "files": [
    "dist/",
    "!dist/client/pictures/",
    "!dist/client/AGENTS.md",
    "scripts/postinstall.mjs",
    "scripts/recover-handoff.mjs",
    "scripts/prepare-build.js"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "John C. Waters <john@johncwaters.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncwaters/glissa.git"
  },
  "homepage": "https://github.com/johncwaters/glissa#readme",
  "bugs": {
    "url": "https://github.com/johncwaters/glissa/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "dashboard",
    "session-manager",
    "xterm",
    "windows",
    "linux"
  ],
  "scripts": {
    "start": "node dist/server/index.js",
    "lint": "biome check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.public.json",
    "test:container": "docker build -f test/container/Dockerfile -t glissa-remote-test . && docker run --rm glissa-remote-test",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "node scripts/prepare-build.js",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.2"
  }
}
