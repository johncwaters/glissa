{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": []
  },
  "include": [
    "public/**/*.ts",
    "public/**/*.d.ts"
  ],
  "exclude": [
    "node_modules/**",
    "public/node_modules/**",
    "dist/**"
  ]
}
